# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Пароль для /admin
ADMIN_PASSWORD=
# Любая длинная случайная строка, подписывает cookie админки
ADMIN_SECRET=

# Сбор данных (нужны только collector-у, т.е. GitHub Actions)
APIFY_TOKEN=
YOUTUBE_API_KEY=

# Кнопка «Обновить сейчас» в админке (необязательно):
# GitHub token с правом actions:write и репозиторий вида owner/repo
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
